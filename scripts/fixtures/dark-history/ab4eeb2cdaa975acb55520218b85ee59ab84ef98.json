 island is scarce. The island was once used as a base for pirates.","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}},"mime":"image/jpeg"}]},{"pageid":733565,"ns":6,"title":"File:Flag of the United States (1867–1877).svg","imagerepository":"local","imageinfo":[{"size":2975,"width":1235,"height":650,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_the_United_States_%281867%E2%80%931877%29.svg/1280px-Flag_of_the_United_States_%281867%E2%80%931877%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":674,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_the_United_States_%281867%E2%80%931877%29.svg/3840px-Flag_of_the_United_States_%281867%E2%80%931877%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_the_United_States_%281867%E2%80%931877%29.svg/1280px-Flag_of_the_United_States_%281867%E2%80%931877%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":674,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_the_United_States_%281867%E2%80%931877%29.svg/3840px-Flag_of_the_United_States_%281867%E2%80%931877%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/f3/Flag_of_the_United_States_%281867%E2%80%931877%29.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Flag_of_the_United_States_(1867%E2%80%931877).svg","descriptionshortu