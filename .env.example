# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Provider - Pick one (or use OpenRouter for access to all)
# Uncomment the line you use — placeholder values must stay commented out
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# Free-first text routing — enabled by default.
# When true, paid text provider keys found in the environment (OPENAI_API_KEY,
# MOONSHOT_API_KEY, MIMO_API_KEY, GLM_API_KEY) are ignored with a warning and
# OPENROUTER_API_KEY is used for ":free" models only. A provider chosen explicitly
# in credentials.json (aiProvider) is always honoured.
FREE_LLM_ONLY=true
# Free providers, tried after Gemini in FREE_LLM_PROVIDER_ORDER.
# Viewer comments (comment analysis, reply drafts) are only sent to Groq among these:
# NVIDIA logs trial usage, Mistral free mode and OpenRouter free models may log/train.
# GROQ_API_KEY=your-groq-api-key-here
# NVIDIA_API_KEY=your-nvidia-api-key-here
# MISTRAL_API_KEY=your-mistral-api-key-here
# FREE_LLM_PROVIDER_ORDER=groq,nvidia,mistral,openrouter
# FREE_LLM_DISABLE=
# FREE_LLM_TIMEOUT_MS=45000
# Mistral model ids per tier (comma-separated); confirm with GET https://api.mistral.ai/v1/models
# MISTRAL_MODEL_QUALITY=mistral-large-latest,mistral-medium-latest
# MISTRAL_MODEL_BALANCED=mistral-medium-latest,mistral-small-latest
# MISTRAL_MODEL_FAST=mistral-small-latest

# ElevenLabs TTS (optional, higher quality than OpenAI TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-voice-id-here

# AI video generation (optional; local slideshow is the no-cost default)
# VIDEO_PROVIDER=slideshow
# VIDEO_PROVIDER_ORDER=seedance,minimax_h3,google_omni,kling,wan,slideshow
# VIDEO_GENERATION_MODE=hybrid
# VIDEO_CLIP_DURATION=8
# VIDEO_MAX_GENERATED_SECONDS=60
# VIDEO_RESOLUTION=720p
# VIDEO_ASPECT_RATIO=16:9

# Seedance 2.5 through Replicate
# REPLICATE_API_TOKEN=your-replicate-api-token-here
# REPLICATE_API_KEY=your-replicate-api-token-here
# SEEDANCE_MODEL=bytedance/seedance-2.5

# MiniMax H3
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_VIDEO_MODEL=MiniMax-H3

# Google Gemini Omni Flash uses GEMINI_API_KEY above
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash

# Kling 3.0 Omni
# KLING_ACCESS_KEY=your-kling-access-key-here
# KLING_SECRET_KEY=your-kling-secret-key-here
# KLING_VIDEO_MODEL=kling-v3-omni

# Alibaba Wan 2.7
# DASHSCOPE_API_KEY=your-dashscope-api-key-here
# DASHSCOPE_VIDEO_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
# DASHSCOPE_TASK_ENDPOINT=https://dashscope-intl.aliyuncs.com/api/v1/tasks

# Free media policy — enabled by default for this channel.
# When true, paid AI image/video fallback is blocked.
FREE_MEDIA_ONLY=true
# Built-in 1080x1920 procedural Dark Stickman renderer. Keeps core production free and quota-independent.
LOCAL_STICKMAN_RENDERER=true
# Moving beats instead of stills with a zoom (same character; only joint angles, props and camera move).
# Off by default; the owner turns it on after approving a sample. Frames render at RENDER_SCALE of
# 1080x1920 (0.5 = about 4x faster, same look on a phone) and FPS (12 = 2D "on twos"); beats past
# MAX_SECONDS of total render time keep their still. Any beat that fails keeps its still.
ANIMATED_SCENES=false
# ANIMATED_SCENES_FPS=12
# ANIMATED_SCENES_RENDER_SCALE=0.5
# ANIMATED_SCENES_MAX_SECONDS=480

# Gemini media generation — optional enhancement; core Dark Stickman scene generation works locally without image quota
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional FREE backup voice used when Gemini TTS fails or its free quota is
# exhausted. Any local engine works; {text} = text file, {wav} = output WAV.
# Example (Piper, see deploy/oracle-vm/README.md):
# LOCAL_TTS_COMMAND=/home/ubuntu/piper/bin/python3 -m piper -m en_US-ljspeech-high --data-dir /home/ubuntu/piper-voices --input-file {text} -f {wav}
# LOCAL_TTS_LABEL=piper:en_US-ljspeech-high
# One narrator for the whole channel: with NARRATOR_LOCK on (default) only the first voice narrates and
# a failure fails the job closed (retried later) instead of shipping a Short with another voice.
# NARRATOR_LOCK=false re-enables the fallback to the local voice above.
NARRATOR_LOCK=true

# Horror sound design (FFmpeg-synthesized, original, free). Voice is normalized to -16 LUFS,
# an ambient bed sits under it and a hook thud / twist stab are added. The audio_mix QA gate
# blocks a Short whose mix is missing or whose final loudness / true peak is off.
# AMBIENT_AUDIO_ENABLED=true
# AMBIENT_AUDIO_REQUIRED=true
# AMBIENT_BED_UNDER_VOICE_DB=15
# AMBIENT_STINGER_UNDER_PEAK_DB=8
# GEMINI_TTS_VOICE=Kore

# FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# DarkzSEO discoverability preflight (bundled and advisory; external checkout is explicit and falls back safely)
# DARKZSEO_PYTHON=python
# DARKZSEO_PATH=../darkzseo/darkzseo.py
# DARKZSEO_TIMEOUT_MS=30000

# Optional OAuth loopback override; Desktop app credentials are required.
# YOUTUBE_REDIRECT_URI=http://127.0.0.1


# Application Settings
NODE_ENV=production
HOST=127.0.0.1
PORT=3456
LOG_LEVEL=info

# Channel Settings
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience description

# YouTube Settings
# Safe boot defaults. The Oracle production activator enables autonomous public
# uploads only after tests, readiness, service health and the seven-agent runtime pass.
# Four independent controls (never interchangeable):
#   AUTONOMOUS_MODE        orchestrator may run without continuous human interaction
#   YOUTUBE_UPLOAD_ENABLED uploads technically permitted; false = emergency kill switch
#   APPROVAL_REQUIRED      every finished video needs individual human approval
#   AUTOMATION_PAUSED      global pause; running jobs stop at the next stage checkpoint
# Mode 1 (test/dev): uploads off, approval on. Finished Shorts end READY_FOR_PUBLISH.
# Mode 2 (autonomous production): AUTONOMOUS_MODE=true APPROVAL_REQUIRED=false
#   AUTOMATION_PAUSED=false YOUTUBE_UPLOAD_ENABLED=true (set by the operator only).
AUTONOMOUS_MODE=false
YOUTUBE_UPLOAD_ENABLED=false
APPROVAL_REQUIRED=true
AUTOMATION_PAUSED=false
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1080
MAX_IMAGE_HEIGHT=1920
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# Security
# Optional. If set, mutating API routes require this value in the x-api-key header.
API_KEY=

# Optional. Generation jobs run one at a time by default to control API spend.
MAX_CONCURRENT_JOBS=1

# Optional. Each retry-safe generation stage gets one bounded retry by default.
GENERATION_STAGE_MAX_ATTEMPTS=2
GENERATION_RETRY_BASE_MS=1000

# Optional Slack/Discord-compatible webhook for failures and review alerts.
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/...

# Optional free Telegram alerts (upload published/blocked/failed, pause/resume,
# kill switch, failures). Create a bot with @BotFather, then set both values
# ONLY in the service environment on the VM. Never commit them.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_NOTIFY_ALL=false

# Maximum agent-posted comment replies per day (Engagement studio; default 50)
# ENGAGEMENT_DAILY_REPLY_CAP=50

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
# Horror Stickman cadence targets
LONG_FORM_PER_WEEK=0
SHORTS_PER_WEEK=21
SHORTS_PER_DAY_TARGET=3

# Alerts and self-healing of the scheduler (all optional; defaults shown)
# REQUIRED before any upload: the id of the YouTube channel the Shorts must go to (it is public, it is in the channel URL).
# Uploads are held, and the readiness check fails, while this is empty or the authorized Google account exposes a different channel.
YOUTUBE_EXPECTED_CHANNEL_ID=
# Minimum hours between automatic production-readiness re-checks that the scheduler runs when it finds readiness blocked.
READINESS_SELF_HEAL_HOURS=6
# Alert (Telegram) when no Short has reached review/approval for this many hours although nothing is running
# (never lower than twice the pacing interval).
PRODUCTION_STALL_HOURS=16

# Dark History story pool (off by default; researches true stories with licensed footage, alerts when low)
DARK_HISTORY_POOL_ENABLED=false

# Wikimedia asks API clients to identify themselves with a contact URL or address
WIKIMEDIA_CONTACT=
