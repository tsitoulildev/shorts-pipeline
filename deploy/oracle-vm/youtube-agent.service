[Unit]
Description=YouTube Agent Channel (uploads disabled)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/ubuntu/youtube-agent-channel/.env

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/youtube-agent-channel
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=FREE_MEDIA_ONLY=true
Environment=YOUTUBE_UPLOAD_ENABLED=false
Environment=APPROVAL_REQUIRED=true
Environment=AUTOMATION_PAUSED=false
Environment=FFMPEG_PATH=/usr/bin/ffmpeg
Environment=FFPROBE_PATH=/usr/bin/ffprobe
ExecStart=/usr/bin/env node /home/ubuntu/youtube-agent-channel/index.js
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
